// Copy this file to Config/ProofKit.local.xcconfig and fill in local values.
// Config/ProofKit.local.xcconfig is git-ignored.
//
// Never commit Supabase publishable keys, anon keys, service-role keys, or
// other credentials to tracked source.

PROOFKIT_SUPABASE_PUBLISHABLE_KEY = <your-supabase-publishable-key>
PROOFKIT_REVENUECAT_API_KEY = <your-revenuecat-public-sdk-key>
PROOFKIT_POSTHOG_PROJECT_TOKEN = <your-posthog-project-token>
// xcconfig treats // as a comment, so split the URL slash pair with $().
PROOFKIT_POSTHOG_HOST = https:/$()/us.i.posthog.com
